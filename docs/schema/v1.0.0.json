{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidencepack/tls@v1",
  "title": "TLS posture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "endpoints", "summary"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endpoint_result"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    }
  },
  "$defs": {
    "endpoint_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "reachable", "assessment"],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "reachable": {
          "type": "boolean"
        },
        "tls": {
          "$ref": "#/$defs/tls_details"
        },
        "certificate": {
          "$ref": "#/$defs/certificate"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tls_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_support"],
      "properties": {
        "negotiated_version": {
          "type": "string"
        },
        "negotiated_cipher_suite": {
          "type": "string"
        },
        "protocol_support": {
          "$ref": "#/$defs/protocol_support"
        }
      }
    },
    "protocol_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls_1_0", "tls_1_1", "tls_1_2", "tls_1_3"],
      "properties": {
        "tls_1_0": {
          "type": "boolean"
        },
        "tls_1_1": {
          "type": "boolean"
        },
        "tls_1_2": {
          "type": "boolean"
        },
        "tls_1_3": {
          "type": "boolean"
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before",
        "not_after",
        "expires_in_days",
        "fingerprint_sha256",
        "chain_length",
        "trusted_chain",
        "hostname_valid"
      ],
      "properties": {
        "subject_common_name": {
          "type": "string"
        },
        "issuer_common_name": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "expires_in_days": {
          "type": "integer"
        },
        "dns_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ip_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "signature_algorithm": {
          "type": "string"
        },
        "public_key_algorithm": {
          "type": "string"
        },
        "chain_length": {
          "type": "integer",
          "minimum": 1
        },
        "trusted_chain": {
          "type": "boolean"
        },
        "hostname_valid": {
          "type": "boolean"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_valid",
        "hostname_valid",
        "expired",
        "expiring_soon",
        "modern_protocol",
        "legacy_protocol_supported"
      ],
      "properties": {
        "certificate_valid": {
          "type": "boolean"
        },
        "hostname_valid": {
          "type": "boolean"
        },
        "expired": {
          "type": "boolean"
        },
        "expiring_soon": {
          "type": "boolean"
        },
        "modern_protocol": {
          "type": "boolean"
        },
        "legacy_protocol_supported": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_endpoints",
        "reachable_pct",
        "certificate_valid_pct",
        "hostname_valid_pct",
        "modern_protocol_pct",
        "expiring_soon_pct",
        "legacy_protocol_supported_pct",
        "all_certificates_valid",
        "all_modern_protocol"
      ],
      "properties": {
        "total_endpoints": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "certificate_valid_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hostname_valid_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "modern_protocol_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "expiring_soon_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "legacy_protocol_supported_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "all_certificates_valid": {
          "type": "boolean"
        },
        "all_modern_protocol": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
